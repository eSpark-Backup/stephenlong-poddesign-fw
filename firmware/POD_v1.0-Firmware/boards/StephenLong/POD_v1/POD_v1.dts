/dts-v1/;
#include <nordic/nrf52840_qiaa.dtsi>
#include "POD_v1-pinctrl.dtsi"

/ {
	model = "Stephen Long POD project - board v1.0";
	compatible = "StephenLong,POD-v1";

	chosen {
		zephyr,sram = &sram0;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
	};
};

&flash0 {
	partitions {
		compatible = "fixed-partitions";
		#address-cells = <1>;
		#size-cells = <1>;

		boot_partition: partition@0 {
			label = "mcuboot";
			reg = <0x00000000 DT_SIZE_K(48)>;
		};

		slot0_partition: partition@c000 {
			label = "image-0";
			reg = <0x0000c000 DT_SIZE_K(472)>;
		};

		slot1_partition: partition@82000 {
			label = "image-1";
			reg = <0x00082000 DT_SIZE_K(472)>;
		};

		storage_partition: partition@f8000 {
			label = "storage";
			reg = <0x000f8000 DT_SIZE_K(32)>;
		};
	};
};
&usbd {
	status = "disabled";
};

&gpiote {
	status = "okay";
};

&systick {
	status = "disabled";
};

&i2c0 {
	status = "okay";
	compatible = "nordic,nrf-twim";
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_FAST>;
	label = "I2C_0";
	shtc3@70 {
		compatible = "sensirion,shtcx";
		reg = <0x70>;
		measure-mode = "normal";
		clock-stretching;
		label = "SHTC3";
        status = "okay";
	};

	max17048:max17048@36 {
		compatible = "maxim,max17048";
		reg = <0x36>;
		// // irq-gpios = <&gpio1 8 (GPIO_ACTIVE_LOW)>;  // ALERT pin
		// // // interrupts-extended = <&gpio1 8 GPIO_ACTIVE_LOW>;
		// interrupt-parent = <&gpiote>;  // or <&gpio0> or <&nvic> depending on source
        // interrupts = <8 1>; // pin 8, edge trigger or mode (see below)
		label = "MAX17048";
        status = "okay";
	};
};

&gpio0 {
	status = "okay";
};

&gpio1 {
	label = "GPIO_1";
	status = "okay";
};

